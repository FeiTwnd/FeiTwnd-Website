<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>cc.feitwnd</groupId>
        <artifactId>FeiTwndBackend</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>
    <artifactId>FeiTwnd-ai</artifactId>

    <description>AI 摘要扩展模块：基于 langchain4j 的 OpenAI 兼容协议实现，仅通过契约层与主程序解耦，可插拔构建</description>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <dependencies>
        <!-- 契约层：主程序与扩展模块共同依赖的接口 -->
        <dependency>
            <groupId>cc.feitwnd</groupId>
            <artifactId>FeiTwnd-extension-api</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- 公共模块：统一返回结果 Result 等 -->
        <dependency>
            <groupId>cc.feitwnd</groupId>
            <artifactId>FeiTwnd-common</artifactId>
            <version>1.0-SNAPSHOT</version>
        </dependency>

        <!-- LangChain4j 核心（手动构造模型，不引入 spring-boot-starter 自动配置） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>

        <!-- LangChain4j OpenAI 兼容协议：通过 base-url 适配 DeepSeek/通义/智谱/OpenRouter 等 -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
        </dependency>

        <!-- 编译期依赖 Spring 相关注解，运行时由主程序提供 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
