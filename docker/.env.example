# MySQL配置
MYSQL_ROOT_PASSWORD=your_root_password_here
MYSQL_PASSWORD=your_password_here

# Redis配置 (可选，默认无需密码)
# REDIS_PASSWORD=your_redis_password

# 时区
TZ=Asia/Shanghai

# ============================================
# 后端应用配置 (必须修改)
# ============================================

# JWT密钥 (必须修改! 使用随机字符串，至少32位)
JWT_SECRET_KEY=your-very-long-random-secret-key-here-change-this

# JWT过期时间(毫秒)，默认24小时
# JWT_TTL=86400000

# ============================================
# 阿里云OSS配置 (必须修改)
# ============================================
# OSS地域节点，如: oss-cn-shanghai.aliyuncs.com
ALIOSS_ENDPOINT=your-oss-endpoint-here
# OSS AccessKey ID
ALIOSS_ACCESS_KEY_ID=your-alioss-access-key-id
# OSS AccessKey Secret
ALIOSS_ACCESS_KEY_SECRET=your-alioss-access-key-secret
# OSS Bucket 名称
ALIOSS_BUCKET_NAME=your-bucket-name

# ============================================
# 邮件配置 (必须修改)
# ============================================
# SMTP服务器地址
MAIL_HOST=smtp.qq.com
# SMTP服务器端口
MAIL_PORT=587
# 邮箱账号
MAIL_USERNAME=your-email@example.com
# 邮箱授权码
MAIL_PASSWORD=your-email-auth-code

# 发送者昵称
EMAIL_PERSONAL=YourName
# 发送者邮箱 (与 MAIL_USERNAME 保持一致)
EMAIL_FROM=your-email@example.com
# 访客登录验证码 (管理员知道即可)
VISITOR_VERIFY_CODE=123456

# ============================================
# 网站URL配置
# ============================================
WEBSITE_TITLE=YourSiteTitle
WEBSITE_HOME=https://example.com
WEBSITE_ADMIN=https://admin.example.com
WEBSITE_CV=https://cv.example.com
WEBSITE_BLOG=https://blog.example.com
